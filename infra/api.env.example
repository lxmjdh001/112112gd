# Store the real file at /etc/d1scrm/api.env with root ownership and mode 0600.
# The d1scrm Unix user authenticates through PostgreSQL peer authentication.
DATABASE_URL=postgres:///d1scrm?host=/var/run/postgresql&user=d1scrm&sslmode=disable
GONGDAN_MASTER_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
LISTEN_ADDR=127.0.0.1:18080
GONGDAN_PUBLIC_URL=https://scrm.chuhai7.com
WHATSAPP_GRAPH_VERSION=v25.0
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_OF_AT_LEAST_12_CHARACTERS
